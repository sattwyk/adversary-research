@@ -0,0 +1,226 @@
+//! Experiment-only control points for the production flush worker.
+//!
+//! This module does not implement a WAL or a scheduler. It lets an external
+//! deterministic scheduler stop the existing native worker at its semantic
+//! boundaries and decide the result of the syscalls the worker already makes.
+
+use std::fs::File;
+use std::io;
+use std::io::IoSlice;
+use std::io::Write;
+#[cfg(feature = "adversary")]
+use std::sync::Arc;
+#[cfg(feature = "adversary")]
+use std::sync::OnceLock;
+#[cfg(feature = "adversary")]
+use std::sync::RwLock;
+
+/// The kind of request crossing the existing bounded worker queue.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum RequestKind {
+    Write,
+    AppendFile,
+    RemoveChunks,
+    GetFlushStat,
+}
+
+/// Observable synchronization and effect boundaries in the native worker.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Event {
+    BeforeSend {
+        seq: u64,
+        kind: RequestKind,
+        bytes: usize,
+        sync: bool,
+    },
+    AfterReserve {
+        seq: u64,
+    },
+    AfterSend {
+        seq: u64,
+        accepted: bool,
+    },
+    BeforeFirstReceive,
+    AfterFirstReceive {
+        seq: Option<u64>,
+    },
+    BeforeBatchReceive {
+        items: usize,
+    },
+    AfterBatchReceive {
+        seq: Option<u64>,
+    },
+    BeforeWrite {
+        items: usize,
+        bytes: usize,
+    },
+    AfterWrite {
+        succeeded: bool,
+    },
+    BeforeSync {
+        upto_offset: u64,
+        files: usize,
+    },
+    AfterSync {
+        upto_offset: u64,
+        succeeded: bool,
+    },
+    BeforePersistedCallback {
+        upto_offset: u64,
+    },
+    AfterPersistedCallback {
+        upto_offset: u64,
+    },
+    BeforeRequestCallback {
+        upto_offset: u64,
+    },
+    AfterRequestCallback {
+        upto_offset: u64,
+    },
+    BeforeComplete {
+        seq: u64,
+    },
+    AfterComplete {
+        seq: u64,
+    },
+    BeforeNonWrite {
+        kind: RequestKind,
+    },
+    AfterNonWrite {
+        kind: RequestKind,
+        succeeded: bool,
+    },
+    WorkerStopped {
+        succeeded: bool,
+    },
+}
+
+/// Decision at the worker's existing timed receive boundary.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum BatchReceive {
+    /// Execute the production `recv_timeout` call.
+    Native,
+    /// End the current batch as though its receive deadline expired.
+    Timeout,
+}
+
+/// Controller implemented by the experimental deterministic scheduler.
+///
+/// Default effect methods call the same native syscalls as the unmodified
+/// worker. Implementations may delay at `checkpoint`, return short writes, or
+/// inject errors without replacing the worker's batching and callback logic.
+#[cfg(feature = "adversary")]
+pub trait Controller: Send + Sync + 'static {
+    fn checkpoint(&self, event: Event);
+
+    fn batch_receive(&self, items: usize) -> BatchReceive {
+        let _ = items;
+        BatchReceive::Native
+    }
+
+    fn write_vectored(
+        &self,
+        file: &File,
+        bufs: &[IoSlice<'_>],
+    ) -> io::Result<usize> {
+        let mut file = file;
+        file.write_vectored(bufs)
+    }
+
+    fn sync_data(&self, file: &File) -> io::Result<()> {
+        file.sync_data()
+    }
+}
+
+#[cfg(feature = "adversary")]
+fn slot() -> &'static RwLock<Option<Arc<dyn Controller>>> {
+    static SLOT: OnceLock<RwLock<Option<Arc<dyn Controller>>>> =
+        OnceLock::new();
+    SLOT.get_or_init(|| RwLock::new(None))
+}
+
+/// Installs one process-wide controller for an experiment trial.
+#[cfg(feature = "adversary")]
+pub fn install(controller: Arc<dyn Controller>) -> ControllerGuard {
+    let mut guard = slot().write().unwrap();
+    assert!(
+        guard.is_none(),
+        "an adversary controller is already installed"
+    );
+    *guard = Some(controller);
+    ControllerGuard { installed: true }
+}
+
+/// Clears the controller at the end of a trial.
+#[cfg(feature = "adversary")]
+pub struct ControllerGuard {
+    installed: bool,
+}
+
+#[cfg(feature = "adversary")]
+impl Drop for ControllerGuard {
+    fn drop(&mut self) {
+        if self.installed {
+            *slot().write().unwrap() = None;
+            self.installed = false;
+        }
+    }
+}
+
+#[cfg(feature = "adversary")]
+fn current() -> Option<Arc<dyn Controller>> {
+    slot().read().unwrap().clone()
+}
+
+pub(crate) fn checkpoint(event: Event) {
+    #[cfg(feature = "adversary")]
+    {
+        if let Some(controller) = current() {
+            controller.checkpoint(event);
+        }
+    }
+    #[cfg(not(feature = "adversary"))]
+    {
+        let _ = event;
+    }
+}
+
+pub(crate) fn batch_receive(items: usize) -> BatchReceive {
+    #[cfg(feature = "adversary")]
+    {
+        return current()
+            .map(|controller| controller.batch_receive(items))
+            .unwrap_or(BatchReceive::Native);
+    }
+    #[cfg(not(feature = "adversary"))]
+    {
+        let _ = items;
+        BatchReceive::Native
+    }
+}
+
+pub(crate) fn write_vectored(
+    file: &File,
+    bufs: &[IoSlice<'_>],
+) -> io::Result<usize> {
+    #[cfg(feature = "adversary")]
+    {
+        if let Some(controller) = current() {
+            return controller.write_vectored(file, bufs);
+        }
+    }
+
+    let mut file = file;
+    file.write_vectored(bufs)
+}
+
+pub(crate) fn sync_data(file: &File) -> io::Result<()> {
+    #[cfg(feature = "adversary")]
+    {
+        if let Some(controller) = current() {
+            return controller.sync_data(file);
+        }
+    }
+
+    file.sync_data()
+}
