+
+fn request_meta<W: WalTypes>(
+    req: &WorkerRequest<W>,
+) -> (RequestKind, usize, bool) {
+    match req {
+        WorkerRequest::Write(write) => {
+            (RequestKind::Write, write.data.len(), write.sync)
+        }
+        WorkerRequest::AppendFile(_) => (RequestKind::AppendFile, 0, false),
+        WorkerRequest::RemoveChunks { .. } => {
+            (RequestKind::RemoveChunks, 0, false)
+        }
+        WorkerRequest::GetFlushStat { .. } => {
+            (RequestKind::GetFlushStat, 0, false)
+        }
+    }
+}
